rules_version = '2';

// First pass: permissive but auth-gated. Tightening (per-room ACLs, hand secrecy
// via authUid match) happens after the room/hand schema lands.
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared with the scorekeeper. Keep open during early rollout to avoid
    // breaking the existing app — revisit before public launch.
    match /players/{playerId} {
      allow read, write: if true;
    }
    match /games/{gameId} {
      allow read, write: if true;
    }

    // All-rooms tally of which reaction phrases get used, one doc per
    // phrase. No personal data: just a phrase, a count and a timestamp.
    match /reactionStats/{phraseId} {
      allow read, write: if request.auth != null;
    }

    // Multiplayer state. Anonymous auth required so opponents can't read each
    // other's hands once we tighten rules below.
    match /rooms/{code} {
      allow read, write: if request.auth != null;

      match /players/{playerName} {
        allow read, write: if request.auth != null;
      }

      // Per-message chat docs. Their own subcollection so a message is a
      // tiny write that does not re-push the whole room doc to every
      // phone, see src/lib/chat.ts.
      match /chat/{messageId} {
        allow read, write: if request.auth != null;
      }

      // Per-round archive (log slice + tricks of a finished round), written
      // at round end so the room doc only carries the CURRENT round. This
      // is what keeps the per-play download small on a bad connection.
      match /rounds/{round} {
        allow read, write: if request.auth != null;
      }

      match /hands/{playerName} {
        // TODO(step 5): allow read only when request.auth.uid matches the
        // authUid stored on rooms/{code}/players/{playerName}.
        allow read, write: if request.auth != null;
      }
    }
  }
}
